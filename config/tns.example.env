# Copy to .env and fill values.
#
# IMPORTANT:
# - This repo uses env vars consumed by src/firstlight/tns/client.py
# - FIRSTLIGHT_TNS_SEND is a kill-switch: sending is DISABLED unless you set it to 1.

# --- Kill-switch (required for any real submit) ---
FIRSTLIGHT_TNS_SEND=0

# --- TNS API ---
# Example (you must provide the correct base URL you use):
# TNS_API_URL=https://www.wis-tns.org/api
TNS_API_URL=
TNS_API_KEY=

# User-Agent required by TNS (keep stable; include a marker for your pipeline)
TNS_USER_AGENT=

# Reporter identity shown in discovery certificate text (mandatory for payload building)
TNS_REPORTER_NAME=

# Optional IDs (leave empty if you don't know; the client will omit them)
TNS_REPORTING_GROUPID=
TNS_DISCOVERY_DATA_SOURCEID=1
TNS_INSTRUMENTID=1

# Optional photometry config
# Use "auto" to map ZTF fid->TNS filter ids (110/111/112 in this codebase)
TNS_PHOT_FILTERID=auto
TNS_NONDET_FILTER_VALUE=auto
TNS_PHOT_FLUX_UNITS=1
TNS_NONDET_FLUX_UNITS=1

# Optional: submission transport selector (auto|form|multipart|json)
TNS_SUBMIT_MODE=auto

# Optional: HTTP timeout
TNS_TIMEOUT_S=30
